# Copy to .env and fill in. Do not commit .env.

# extractive | cloud | ollama | lora
LLM_BACKEND=extractive

# --- Option A: cloud-hosted, OpenAI-compatible API ---
# Groq (free tier):           https://api.groq.com/openai/v1         model e.g. openai/gpt-oss-20b
# Hugging Face router:        https://router.huggingface.co/v1       model e.g. Qwen/Qwen2.5-7B-Instruct
# OpenRouter (free models):   https://openrouter.ai/api/v1           model e.g. a ":free" model id
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_TIMEOUT=30

# --- Option B: Ollama local LLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# --- LoRA adapter trained in finetune/ (local only) ---
LORA_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LORA_ADAPTER_PATH=finetune/adapters/college-lora

# --- App settings ---
MAX_QUESTION_CHARS=1000
RATE_LIMIT_PER_MINUTE=30
MIN_SCORE=0.17
TOP_K=3
LOG_LEVEL=INFO
